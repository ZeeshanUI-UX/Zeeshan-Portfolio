{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/projects/strida/", "destination": "/projects/flujo/", "permanent": true },
    { "source": "/projects/bravo/", "destination": "/projects/aces-awards/", "permanent": true },
    { "source": "/projects/nitro/", "destination": "/projects/deut/", "permanent": true },
    { "source": "/projects/fargo/", "destination": "/projects/wepaak/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
